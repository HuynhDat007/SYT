# Port ứng dụng chạy trên Host
PORT=3000

# Kết nối MongoDB (Atlas Cloud hoặc Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Chuỗi bí mật mã hóa Session Cookie
SESSION_SECRET=syt_health_check_secret_key_2026_super_secure

# (Tùy chọn) URL domain công khai của app (dùng cho tính năng keep-alive/self-ping)
APP_URL=http://localhost:3000
